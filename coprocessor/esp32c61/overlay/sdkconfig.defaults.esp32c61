CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_160=y

# BT Configuration
CONFIG_ESP_HOSTED_CP_BT=n
CONFIG_BT_ENABLED=n
CONFIG_BT_CONTROLLER_ONLY=n
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_LE_SLEEP_ENABLE=y

# SPI/SDIO only
CONFIG_BT_LE_HCI_INTERFACE_USE_RAM=y

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.esp32c61.csv"
CONFIG_ESP_PKT_STATS=y

# Absorb video-frame UDP bursts before the P4 host drains SDIO.
CONFIG_ESP_SDIO_TX_Q_SIZE=20

# Keep the Wi-Fi RX hardware pool ahead of the AMPDU receive window. The
# defaults (10/32/6) lose frame-sized UDP bursts before the Hosted callback.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=64
CONFIG_ESP_WIFI_RX_BA_WIN=12
